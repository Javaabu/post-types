{
    "name": "javaabu/post-types",
    "description": "WordPress-style post types for Laravel: fluent definitions with taxonomies, statuses and scheduling, javaabu/meta fields, javaabu/mediapicker media and javaabu/block-editor content, admin pages with filters and bulk actions, and public archives with configurable permalinks, in Blade and Inertia React",
    "homepage": "https://github.com/Javaabu/post-types",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "post-types",
        "cms",
        "taxonomies",
        "permalinks",
        "blade",
        "inertia",
        "react",
        "dhivehi"
    ],
    "authors": [
        {
            "name": "Javaabu Pvt. Ltd.",
            "email": "info@javaabu.com",
            "homepage": "https://javaabu.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "javaabu/block-editor": "^1.0@dev",
        "javaabu/bulk-actions": "^1.0@dev",
        "javaabu/filters": "^1.0@dev",
        "javaabu/forms": "^2.0@dev",
        "javaabu/manifest": "^1.0@dev",
        "javaabu/mediapicker": "^1.0@dev",
        "javaabu/meta": "^1.0@dev",
        "javaabu/permissions": "^3.0@dev",
        "javaabu/stencil": "^1.0@dev"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "javaabu/boost-javaabu-guidelines": "^1.4",
        "javaabu/translatable": "^3.0@dev",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Renders the admin and public pages with Inertia React when post-types.views is inertia (^2.0)",
        "javaabu/translatable": "Posts and terms in several languages (^3.0)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\PostTypes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\PostTypes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover=clover.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\PostTypes\\PostTypesServiceProvider"
            ],
            "aliases": {
                "PostTypes": "Javaabu\\PostTypes\\Facades\\PostTypes"
            }
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/block-editor"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/bulk-actions"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/filters"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/forms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/manifest"
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/mediapicker"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/meta"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/permissions"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/stencil"
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/translatable"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
